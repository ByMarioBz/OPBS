IDI_ICON1 ICON DISCARDABLE "cmake/windows/obs-studio.ico"

1 VERSIONINFO
FILEVERSION ${OPBS_FILE_VERSION_COMMAS},0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "OPBS"
      VALUE "FileDescription", "OPBS - Presentador multimedia"
      VALUE "FileVersion", "${OPBS_VERSION}"
      VALUE "InternalName", "OPBS"
      VALUE "OriginalFilename", "OPBS.exe"
      VALUE "ProductName", "OPBS"
      VALUE "ProductVersion", "${OPBS_VERSION}"
      VALUE "Comments", "Presentador multimedia basado en OBS Studio"
      VALUE "LegalCopyright", "${OBS_LEGAL_COPYRIGHT}"
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
